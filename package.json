{
  "name": "climbing-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html",
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:api:b": "wrangler dev --local --env gym-b --ip 127.0.0.1 --port 8788",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:b": "wrangler d1 migrations apply DB --local --env gym-b",
    "check:api": "tsc -p tsconfig.worker.json",
    "types:api": "wrangler types worker-configuration.d.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "db:seed": "node scripts/seed-local.mjs gym-a",
    "db:seed:b": "node scripts/seed-local.mjs gym-b",
    "format:api": "prettier --write worker scripts migrations/*.sql tsconfig.worker.json vitest.api.config.ts wrangler.jsonc --ignore-unknown"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "jose": "^6.2.12",
    "playcanvas": "^2.23.2",
    "qrcode": "^1.5.4",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/qrcode": "^1.5.5",
    "miniflare": "^5.20261006.1-alpha",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
