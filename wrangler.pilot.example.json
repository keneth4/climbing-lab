{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "replace-pilot-worker",
  "account_id": "replace-account-id",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "GYM_ID": "replace-pilot-gym",
    "AUTH_ISSUER": "https://defblrjdwgnqyzzgozdf.supabase.co/auth/v1",
    "AUTH_AUDIENCE": "authenticated",
    "PUBLIC_ORIGIN": "https://replace-public-origin"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-database-name",
      "database_id": "replace-database-uuid",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CAPTURES",
      "bucket_name": "replace-captures-bucket"
    }
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
